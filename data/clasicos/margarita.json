[
  {
    "titulo": "A Margarita Debayle",
    "parrafos": [
      {
        "tipo": "verso",
        "texto": "A MARGARITA DEBAYLE"
      },
      {
        "tipo": "verso",
        "texto": "Margarita, está linda la mar,"
      },
      {
        "tipo": "verso",
        "texto": "y el viento"
      },
      {
        "tipo": "verso",
        "texto": "lleva esencia sutil de azahar;"
      },
      {
        "tipo": "verso",
        "texto": "yo siento"
      },
      {
        "tipo": "verso",
        "texto": "en el alma una alondra cantar:"
      },
      {
        "tipo": "verso",
        "texto": "tu acento."
      },
      {
        "tipo": "verso",
        "texto": "Margarita, te voy a contar"
      },
      {
        "tipo": "verso",
        "texto": "un cuento"
      },
      {
        "tipo": "verso",
        "texto": "Este era un rey que tenía"
      },
      {
        "tipo": "verso",
        "texto": "un palacio de diamantes,"
      },
      {
        "tipo": "verso",
        "texto": "una tienda hecha de día"
      },
      {
        "tipo": "verso",
        "texto": "y un rebaño de elefantes."
      },
      {
        "tipo": "verso",
        "texto": "Un kiosco de malaquita,"
      },
      {
        "tipo": "verso",
        "texto": "un gran manto de tisú,"
      },
      {
        "tipo": "verso",
        "texto": "y una gentil princesita,"
      },
      {
        "tipo": "verso",
        "texto": "tan bonita,"
      },
      {
        "tipo": "verso",
        "texto": "Margarita,"
      },
      {
        "tipo": "verso",
        "texto": "tan bonita, como tú."
      },
      {
        "tipo": "verso",
        "texto": "Una tarde, la princesa"
      },
      {
        "tipo": "verso",
        "texto": "vio una estrella aparecer;"
      },
      {
        "tipo": "verso",
        "texto": "la princesa era traviesa"
      },
      {
        "tipo": "verso",
        "texto": "y la quiso ir a coger."
      },
      {
        "tipo": "verso",
        "texto": "La quería para hacerla"
      },
      {
        "tipo": "verso",
        "texto": "decorar un prendedor,"
      },
      {
        "tipo": "verso",
        "texto": "con un verso y una perla"
      },
      {
        "tipo": "verso",
        "texto": "y una pluma y una flor."
      },
      {
        "tipo": "verso",
        "texto": "Las princesas primorosas"
      },
      {
        "tipo": "verso",
        "texto": "se parecen mucho a ti:"
      },
      {
        "tipo": "verso",
        "texto": "Cortan lirios, cortan rosas,"
      },
      {
        "tipo": "verso",
        "texto": "cortan astros. Son así."
      },
      {
        "tipo": "verso",
        "texto": "Pues se fue la niña bella,"
      },
      {
        "tipo": "verso",
        "texto": "bajo el cielo y sobre el mar,"
      },
      {
        "tipo": "verso",
        "texto": "a cortar la blanca estrella"
      },
      {
        "tipo": "verso",
        "texto": "que la hacía suspirar."
      },
      {
        "tipo": "verso",
        "texto": "Y siguió camino arriba,"
      },
      {
        "tipo": "verso",
        "texto": "por la luna y más allá;"
      },
      {
        "tipo": "verso",
        "texto": "más lo malo es que ella iba"
      },
      {
        "tipo": "verso",
        "texto": "sin permiso del papá."
      },
      {
        "tipo": "verso",
        "texto": "Cuando estuvo ya de vuelta"
      },
      {
        "tipo": "verso",
        "texto": "de los parques del Señor,"
      },
      {
        "tipo": "verso",
        "texto": "se miraba toda envuelta"
      },
      {
        "tipo": "verso",
        "texto": "en un dulce resplandor."
      },
      {
        "tipo": "verso",
        "texto": "Y el rey dijo: “¿Qué te has hecho?"
      },
      {
        "tipo": "verso",
        "texto": "Te he buscado y no te hallé;"
      },
      {
        "tipo": "verso",
        "texto": "y ¿qué tienes en el pecho"
      },
      {
        "tipo": "verso",
        "texto": "que encendido se te ve?”"
      },
      {
        "tipo": "verso",
        "texto": "La princesa no mentía."
      },
      {
        "tipo": "verso",
        "texto": "Y así, dijo la verdad:"
      },
      {
        "tipo": "verso",
        "texto": "“Fui a cortar la estrella mía"
      },
      {
        "tipo": "verso",
        "texto": "a la azul inmensidad”."
      },
      {
        "tipo": "verso",
        "texto": "Y el rey clama: “¿No te he dicho"
      },
      {
        "tipo": "verso",
        "texto": "que el azul no hay que tocar?"
      },
      {
        "tipo": "verso",
        "texto": "¡Qué locura! ¡Qué capricho!"
      },
      {
        "tipo": "verso",
        "texto": "El Señor se va a enojar”."
      },
      {
        "tipo": "verso",
        "texto": "Y ella dice: “No hubo intento;"
      },
      {
        "tipo": "verso",
        "texto": "yo me fui no sé por qué;"
      },
      {
        "tipo": "verso",
        "texto": "por las olas y en el viento"
      },
      {
        "tipo": "verso",
        "texto": "fui a la estrella y la corté”."
      },
      {
        "tipo": "verso",
        "texto": "Y el papá dice enojado:"
      },
      {
        "tipo": "verso",
        "texto": "“Un castigo has de tener:"
      },
      {
        "tipo": "verso",
        "texto": "Vuelve al cielo y lo robado"
      },
      {
        "tipo": "verso",
        "texto": "vas ahora a devolver”."
      },
      {
        "tipo": "verso",
        "texto": "La princesa se entristece"
      },
      {
        "tipo": "verso",
        "texto": "por su dulce flor de luz,"
      },
      {
        "tipo": "verso",
        "texto": "cuando entonces aparece"
      },
      {
        "tipo": "verso",
        "texto": "sonriendo el Buen Jesús."
      },
      {
        "tipo": "verso",
        "texto": "Y así dice: “En mis campiñas"
      },
      {
        "tipo": "verso",
        "texto": "esa rosa yo ofrecí"
      },
      {
        "tipo": "verso",
        "texto": "a las dulces lindas niñas"
      },
      {
        "tipo": "verso",
        "texto": "que al soñar piensan en mí”."
      },
      {
        "tipo": "verso",
        "texto": "Viste el rey ropas brillantes,"
      },
      {
        "tipo": "verso",
        "texto": "y luego hace desfilar"
      },
      {
        "tipo": "verso",
        "texto": "cuatrocientos elefantes"
      },
      {
        "tipo": "verso",
        "texto": "a la orilla de la mar."
      },
      {
        "tipo": "verso",
        "texto": "La princesita está bella,"
      },
      {
        "tipo": "verso",
        "texto": "pues ya tiene el prendedor"
      },
      {
        "tipo": "verso",
        "texto": "en que lucen, con la estrella,"
      },
      {
        "tipo": "verso",
        "texto": "verso, perla, pluma y flor."
      },
      {
        "tipo": "verso",
        "texto": "Margarita, está linda la mar,"
      },
      {
        "tipo": "verso",
        "texto": "y el viento"
      },
      {
        "tipo": "verso",
        "texto": "lleva esencia sutil de azahar:"
      },
      {
        "tipo": "verso",
        "texto": "tu aliento."
      },
      {
        "tipo": "verso",
        "texto": "Ya que lejos de mí vas a estar,"
      },
      {
        "tipo": "verso",
        "texto": "guarda, niña, un gentil pensamiento"
      },
      {
        "tipo": "verso",
        "texto": "al que un día te quiso contar"
      },
      {
        "tipo": "verso",
        "texto": "un cuento."
      }
    ]
  }
]